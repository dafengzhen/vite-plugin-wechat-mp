{
  "name": "vite-plugin-wechat-mp",
  "version": "1.1.17",
  "description": "使用 Vite 编译微信小程序",
  "keywords": [
    "mini programs",
    "mp",
    "plugin",
    "vite-plugin",
    "wechat",
    "weixin",
    "wxml",
    "wxss"
  ],
  "homepage": "https://github.com/dafengzhen/vite-plugin-wechat-mp#readme",
  "bugs": {
    "url": "https://github.com/dafengzhen/vite-plugin-wechat-mp/issues"
  },
  "license": "MIT",
  "author": "dafengzhen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dafengzhen/vite-plugin-wechat-mp.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/vite-plugin-wechat-mp.cjs",
  "module": "dist/vite-plugin-wechat-mp.js",
  "types": "dist/vite-plugin-wechat-mp.d.ts",
  "exports": {
    ".": {
      "types": "./dist/vite-plugin-wechat-mp.d.ts",
      "import": "./dist/vite-plugin-wechat-mp.js",
      "require": "./dist/vite-plugin-wechat-mp.cjs",
      "default": "./dist/vite-plugin-wechat-mp.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "tag": "latest"
  },
  "scripts": {
    "dev": "npm build --mode development --watch",
    "build": "tsc && vite build --mode production && npm run build:types",
    "build:types": "tsc -p tsconfig.types.json",
    "preview": "vite preview",
    "test": "echo \"Error: no test specified\" && exit 1",
    "fmt": "oxfmt",
    "lint": "oxlint --fix",
    "lint:fmt": "run-s lint fmt"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "eslint-plugin-perfectionist": "^5.13.0",
    "npm-run-all2": "^9.0.4",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.5"
  },
  "peerDependencies": {
    "vite": ">=8"
  }
}
